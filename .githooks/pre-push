#!/bin/sh
set -eu

# A release tag vX.Y.Z triggers the release workflow, which refuses to publish
# unless package.json carries the same version. Check that here, before the tag
# reaches GitHub.
#
# Ordinary pushes are not checked: main is free to move past the last release
# tag, and the version is bumped when the next release is cut.
#
# git feeds one line per pushed ref: <local ref> <local sha> <remote ref> <remote sha>
zero=0000000000000000000000000000000000000000

while read -r _local_ref local_sha remote_ref _remote_sha; do
  case "$remote_ref" in
    refs/tags/v*) ;;
    *) continue ;;
  esac
  # Deleting a tag pushes the all-zero sha; nothing to verify.
  [ "$local_sha" = "$zero" ] && continue

  tag=${remote_ref#refs/tags/}
  version=$(git show "${local_sha}^{commit}:package.json" 2>/dev/null |
    node -p "JSON.parse(require('fs').readFileSync(0, 'utf8')).version" 2>/dev/null || echo "")
  if [ "v${version}" != "$tag" ]; then
    echo ""
    echo "ERROR: tag ${tag} points at a commit whose package.json version is '${version}'."
    echo "       Bump package.json (and the plugin manifests) first, then tag that commit."
    echo ""
    exit 1
  fi
  echo "pre-push: ${tag} matches package.json"
done
