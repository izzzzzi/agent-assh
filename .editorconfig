root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 4
max_line_length = 120

[*.go]
indent_style = tab
indent_size = 4
max_line_length = 120

[go.mod]
indent_style = tab

[*.{yaml,yml,json,jsonc}]
indent_style = space
indent_size = 2
max_line_length = 120

[*.{md,markdown}]
indent_style = space
indent_size = 2
max_line_length = off

[Makefile]
indent_style = tab

[*.{js,cjs,mjs}]
indent_style = space
indent_size = 2
max_line_length = 120

[*.{sh,bash}]
indent_style = tab
max_line_length = 120

[Dockerfile]
indent_style = tab
